{
  "name": "brand-launch-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "tsc && vite build",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "pnpm run build && pnpm exec wrangler deploy"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "node": ">=24.18 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
